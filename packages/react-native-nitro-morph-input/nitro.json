{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "nitromorphinput"
  ],
  "ios": {
    "iosModuleName": "NitroMorphInput"
  },
  "android": {
    "androidNamespace": [
      "nitromorphinput"
    ],
    "androidCxxLibName": "NitroMorphInput"
  },
  "autolinking": {
    "MorphInputView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridMorphInputView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridMorphInputView"
      }
    },
    "MorphWorklets": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridMorphWorklets"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules",
    "**/lib"
  ]
}
