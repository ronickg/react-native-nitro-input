{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["nitrorollingnumber"],
  "ios": {
    "iosModuleName": "NitroRollingNumber"
  },
  "android": {
    "androidNamespace": ["nitrorollingnumber"],
    "androidCxxLibName": "NitroRollingNumber"
  },
  "autolinking": {
    "RollingNumberView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridRollingNumberView"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridRollingNumberView"
      }
    }
  },
  "ignorePaths": ["**/node_modules", "**/lib"]
}
