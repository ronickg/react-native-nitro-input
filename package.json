{
  "name": "react-native-nitro-rolling-number-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "specs": "bun --cwd packages/react-native-nitro-rolling-number run specs",
    "build": "bun --cwd packages/react-native-nitro-rolling-number run build",
    "typecheck": "bun --cwd packages/react-native-nitro-rolling-number run typecheck",
    "example": "bun --cwd example",
    "test": "bun --cwd packages/react-native-nitro-rolling-number run test"
  },
  "patchedDependencies": {
    "metro@0.87.1": "patches/metro@0.87.1.patch",
    "react-native-nitro-modules@0.37.1": "patches/react-native-nitro-modules@0.37.1.patch"
  }
}
