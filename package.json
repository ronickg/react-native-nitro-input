{
  "name": "react-native-nitro-rolling-number-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "example"
  ],
  "scripts": {
    "specs": "bun --cwd packages/react-native-nitro-rolling-number run specs",
