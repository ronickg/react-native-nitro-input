# Reference write-ups on *other* projects' internals (React Native's TextInput,
# Nitro Modules, worklets, react-native-advanced-input-mask). Research notes,
# not documentation of this library, so they are kept locally rather than
# shipped and reviewed with it.
*-INTERNALS.md

# Screen recordings captured while driving the example app
example/.recordings/

# Native reference apps (UIKit / SwiftUI / Android) used to compare keyboard
# behaviour against. Kept out of the PR like the other internals notes.
native/

# Benchmark traces are large; the pulled device copies are scratch
scripts/bench/results/hitches/*.trace
scripts/bench/results/hitches/bench-results.ndjson
scripts/bench/results/hitches/device.json
scripts/bench/results/hitches/*.stdout.txt
scripts/bench/results/leaks/
modules/*/android/build/
modules/*/android/.cxx/

# React Native Harness cache and crash reports (example/__tests__/*.harness.tsx runs)
example/.harness/
scripts/bench/results/heap/
__pycache__/

# The bench app, the same build outputs as the example's
bench/ios/Pods/
bench/ios/build/
bench/android/build/
bench/android/app/build/
